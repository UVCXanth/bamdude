    "app": {
      "route": "/projects/{order:241}",
      "rewrites": [
        {
          "path": "/api/v1/projects/{order:241}/plan",
          "filter": {"at": "lines.*.rows.*.alternatives", "field": "filename", "match": "^clm01_p1s\\."}
        }
      ],
      "actions": [{"eval": "(() => { const b = [...document.querySelectorAll('[data-testid^=\"plan-row-\"][data-testid$=\"-split\"]')].find((el) => el.closest('tr').textContent.includes('Кришка з вентиляцією')); if (!b) throw new Error('no split on the lid row'); b.click(); })()"}]
