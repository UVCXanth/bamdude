      "route": "#/orders/241",
      "actions": [{"eval": "(() => { const b = [...document.querySelectorAll('[data-a=\"plan-split\"]')].find((el) => el.closest('tr').textContent.includes('Кришка з вентиляцією')); if (!b) throw new Error('no split on the lid row'); b.click(); })()"}]
