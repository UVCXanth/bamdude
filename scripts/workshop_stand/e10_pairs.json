[
  {
    "id": "e10-product-new",
    "widths": "all",
    "measure": "dialog",
    "mockup": {
      "route": "#/products",
      "actions": [
        {
          "eval": "A['product-new']()"
        }
      ]
    },
    "app": {
      "route": "/products",
      "actions": [
        {
          "click_button": "^Новий виріб$"
        }
      ]
    }
  },
  {
    "id": "e10-product-edit",
    "widths": "all",
    "measure": "dialog",
    "pair": "product:1",
    "mockup": {
      "route": "#/products/1",
      "actions": [
        {
          "eval": "A['product-edit']({dataset: {id: '1'}})"
        }
      ]
    },
    "app": {
      "route": "/products/{product:1}",
      "actions": [
        {
          "click_button": "^Редагувати$"
        }
      ]
    }
  },
  {
    "id": "e10-part-new",
    "widths": "all",
    "measure": "dialog",
    "pair": "product:1",
    "mockup": {
      "route": "#/products/1",
      "actions": [
        {
          "eval": "A['part-new']({dataset: {id: '1'}})"
        }
      ]
    },
    "app": {
      "route": "/products/{product:1}",
      "actions": [
        {
          "click_button": "^Додати деталь$"
        }
      ]
    }
  },
  {
    "id": "e10-part-edit-printed",
    "widths": "all",
    "measure": "dialog",
    "pair": "product:1",
    "mockup": {
      "route": "#/products/1",
      "actions": [
        {
          "eval": "A['part-edit']({dataset: {id: '1', part: '101'}})"
        }
      ]
    },
    "app": {
      "route": "/products/{product:1}",
      "actions": [
        {
          "eval": "(() => { const b = [...document.querySelectorAll('[data-testid^=\"part-\"][data-testid$=\"-row\"]')].find((r) => r.querySelector('td')?.textContent.trim().startsWith('Колба')).querySelector('button[aria-label=\"Дії\"]'); b.scrollIntoView({block: 'center', inline: 'center'}); b.click(); })()"
        },
        {
          "click": "[role=menuitem]:has-text(\"Редагувати\")"
        }
      ]
    }
  },
  {
    "id": "e10-part-edit-purchased",
    "widths": "all",
    "measure": "dialog",
    "pair": "product:1",
    "mockup": {
      "route": "#/products/1",
      "actions": [
        {
          "eval": "A['part-edit']({dataset: {id: '1', part: '105'}})"
        }
      ]
    },
    "app": {
      "route": "/products/{product:1}",
      "actions": [
        {
          "eval": "(() => { const b = [...document.querySelectorAll('[data-testid^=\"part-\"][data-testid$=\"-row\"]')].find((r) => r.querySelector('td')?.textContent.trim().startsWith('Гвинт')).querySelector('button[aria-label=\"Дії\"]'); b.scrollIntoView({block: 'center', inline: 'center'}); b.click(); })()"
        },
        {
          "click": "[role=menuitem]:has-text(\"Редагувати\")"
        }
      ]
    }
  },
