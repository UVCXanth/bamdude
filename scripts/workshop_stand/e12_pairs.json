[
  {
    "id": "e12-stock-finished",
    "widths": "all",
    "measure": "list",
    "mockup": {
      "route": "#/stock",
      "actions": [
        {
          "click": "[data-a=\"stock-tab\"][data-v=\"finished\"]"
        }
      ]
    },
    "app": {
      "route": "/stock"
    }
  },
  {
    "id": "e12-stock-parts",
    "widths": "wide",
    "measure": "list",
    "mockup": {
      "route": "#/stock",
      "actions": [
        {
          "click": "[data-a=\"stock-tab\"][data-v=\"parts\"]"
        },
        {
          "click": "[data-a=\"kits-toggle\"]"
        }
      ]
    },
    "app": {
      "route": "/stock?tab=parts",
      "actions": [
        {
          "click_label": "^Показати деталі"
        }
      ]
    }
  },
  {
    "id": "e12-stock-journal",
    "widths": "wide",
    "measure": "list",
    "mockup": {
      "route": "#/stock",
      "actions": [
        {
          "click": "[data-a=\"stock-tab\"][data-v=\"journal\"]"
        }
      ]
    },
    "app": {
      "route": "/stock?tab=journal"
    }
  },
  {
    "id": "e12-stock-notes",
    "widths": "wide",
    "measure": "list",
    "mockup": {
      "route": "#/stock",
      "actions": [
        {
          "click": "[data-a=\"stock-tab\"][data-v=\"docs\"]"
        }
      ]
    },
    "app": {
      "route": "/stock?tab=notes"
    }
  },
  {
    "id": "e12-stock-position",
    "widths": "all",
    "measure": "detail",
    "pair": "fin:1",
    "mockup": {
      "route": "#/stock/1"
    },
    "app": {
      "route": "/stock/{fin:1}"
    }
  },
  {
    "id": "e12-dispatch-note",
    "widths": "all",
    "measure": "detail",
    "pair": "doc:90000",
    "mockup": {
      "route": "#/docs/90000"
    },
    "app": {
      "route": "/stock/dispatch-notes/{doc:90000}"
    }
  },
  {
    "id": "e12-move-receipt",
    "widths": "all",
    "measure": "dialog",
    "mockup": {
      "route": "#/stock",
      "actions": [
        {
          "eval": "A['fin-move']({dataset: {v: 'receive'}})"
        }
      ]
    },
    "app": {
      "route": "/stock",
      "actions": [
        {
          "click_button": "^Надходження$"
        },
        {
          "click_button": "^PR-[0-9]+ · Дифузор «Колба»$"
        }
      ]
    }
  },
  {
    "id": "e12-move-issue",
    "widths": "all",
    "measure": "dialog",
    "pair": "fin:1",
    "mockup": {
      "route": "#/stock/1",
      "actions": [
        {
          "eval": "A['fin-move']({dataset: {v: 'issue', pos: '1'}})"
        }
      ]
    },
    "app": {
      "route": "/stock/{fin:1}",
      "actions": [
        {
          "click_button": "^Видати$"
        }
      ]
    }
  },
  {
    "id": "e12-move-reserve",
    "widths": "all",
