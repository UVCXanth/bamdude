[
  {
    "id": "e11-customers-table",
    "widths": "all",
    "measure": "list",
    "mockup": {
      "route": "#/customers",
      "prefs": {
        "customersView": "table"
      }
    },
    "app": {
      "route": "/customers",
      "storage": {
        "bamdude-customers-view": "table"
      }
    }
  },
  {
    "id": "e11-customers-cards",
    "widths": "wide",
    "measure": "cards",
    "mockup": {
      "route": "#/customers",
      "prefs": {
        "customersView": "cards"
      }
    },
    "app": {
      "route": "/customers",
      "storage": {
        "bamdude-customers-view": "cards"
      }
    }
  },
  {
    "id": "e11-customer-detail",
    "widths": "all",
    "measure": "detail",
    "pair": "customer:1",
    "mockup": {
      "route": "#/customers/1"
    },
    "app": {
      "route": "/customers/{customer:1}"
    }
  },
  {
    "id": "e11-customer-new",
    "widths": "all",
    "measure": "dialog",
    "mockup": {
      "route": "#/customers",
      "actions": [
        {
          "eval": "A['customer-new']()"
        }
      ]
    },
    "app": {
      "route": "/customers",
      "actions": [
        {
          "click_button": "^Новий замовник$"
        }
      ]
    }
  },
  {
    "id": "e11-customer-edit",
    "widths": "all",
    "measure": "dialog",
    "pair": "customer:1",
    "mockup": {
      "route": "#/customers/1",
      "actions": [
        {
          "eval": "A['customer-edit']({dataset: {id: '1'}})"
        }
      ]
    },
    "app": {
      "route": "/customers/{customer:1}",
      "actions": [
        {
          "click_button": "^Редагувати$"
        }
      ]
    }
  },
  {
    "id": "e11-customer-delete",
    "widths": "wide",
    "measure": "dialog",
    "pair": "customer:1",
    "mockup": {
      "route": "#/customers/1",
      "actions": [
        {
          "eval": "A['customer-delete']({dataset: {id: '1'}})"
        }
      ]
    },
    "app": {
      "route": "/customers/{customer:1}",
      "actions": [
        {
          "click_button": "^Дії: ТехноЛаб$"
        },
        {
          "click": "[role=\"menuitem\"]"
        }
      ]
    }
  }
]
