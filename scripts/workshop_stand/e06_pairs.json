[
  {
    "id": "e06-order-new",
    "widths": "all",
    "measure": "dialog",
    "mockup": {
      "route": "#/orders",
      "actions": [
        {"click": "[data-a=\"order-new\"]"}
      ]
    },
    "app": {
      "route": "/projects",
      "actions": [
        {"click_button": "^Нове замовлення$"}
      ]
    }
  },
  {
    "id": "e06-order-edit",
    "widths": "all",
    "measure": "dialog",
    "pair": "order:241",
    "mockup": {
      "route": "#/orders/241",
      "actions": [
        {"eval": "A['order-edit']({dataset: {id: '241'}})"}
      ]
    },
    "app": {
      "route": "/projects/{order:241}",
      "actions": [
        {"click_button": "^Редагувати$"}
      ]
    }
  },
  {
    "id": "e06-order-duplicate",
    "widths": "all",
    "measure": "dialog",
    "pair": "order:241",
    "mockup": {
      "route": "#/orders/241",
      "actions": [
        {"eval": "A['order-duplicate']({dataset: {id: '241'}})"}
      ]
    },
    "app": {
      "route": "/projects/{order:241}",
      "actions": [
        {"click_button": "^Дії замовлення"},
        {"eval": "[...document.querySelectorAll('[role=\"menuitem\"]')].find((e) => e.textContent.trim() === 'Дублювати…').click()"}
      ]
    }
  },
