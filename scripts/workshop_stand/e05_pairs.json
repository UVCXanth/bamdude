[
  {
    "id": "e05-add-products",
    "widths": "all",
    "measure": "dialog",
    "pair": "order:241",
    "mockup": {
      "route": "#/orders/241",
      "actions": [
        {"click": "[data-a=\"line-add\"]"},
        {"eval": "A['add-q']({value: 'CLM'})"},
        {"eval": "A['add-pick']({checked: true, dataset: {id: String(DB.products.find((p) => p.sku === 'CLM-01').id)}})"}
      ]
    },
    "app": {
      "route": "/projects/{order:241}",
      "actions": [
        {"click_button": "^Додати в замовлення$"},
        {"eval": "(() => { const i = document.querySelector('[role=\"dialog\"] [role=\"tabpanel\"]:not([hidden]) input[type=\"search\"]'); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, 'CLM'); i.dispatchEvent(new Event('input', {bubbles: true})); })()"},
        {"check": "[role=\"dialog\"] tr:has-text(\"CLM-01\") input[type=\"checkbox\"]"}
      ]
    }
  },
  {
    "id": "e05-add-parts",
    "widths": "all",
    "measure": "dialog",
    "pair": "order:241",
    "mockup": {
      "route": "#/orders/241",
      "actions": [
        {"click": "[data-a=\"line-add\"]"},
        {"click": "[data-a=\"add-tab\"][data-v=\"parts\"]"},
        {"eval": "A['add-pq']({value: 'clm01'})"},
        {"eval": "[...document.querySelectorAll('[data-change=\"add-ppick\"]')].slice(0, 2).map((e) => e.dataset.id).forEach((id) => A['add-ppick']({checked: true, dataset: {id}}))"}
      ]
    },
    "app": {
      "route": "/projects/{order:241}",
      "actions": [
        {"click_button": "^Додати в замовлення$"},
        {"click_role_tab": "^Деталі з виробу"},
        {"eval": "(() => { const i = document.querySelector('[role=\"dialog\"] [role=\"tabpanel\"]:not([hidden]) input[type=\"search\"]'); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, 'clm01'); i.dispatchEvent(new Event('input', {bubbles: true})); })()"},
        {"check": "[role=\"dialog\"] [role=\"tabpanel\"]:not([hidden]) tbody tr:nth-child(1)[data-testid^=\"add-part-\"] input[type=\"checkbox\"]"},
        {"check": "[role=\"dialog\"] [role=\"tabpanel\"]:not([hidden]) tbody tr:nth-child(2)[data-testid^=\"add-part-\"] input[type=\"checkbox\"]"}
      ]
    }
  },
  {
    "id": "e05-add-plate",
    "widths": "wide",
    "measure": "dialog",
    "pair": "order:241",
    "mockup": {
      "route": "#/orders/241",
      "actions": [
        {"click": "[data-a=\"line-add\"]"},
        {"click": "[data-a=\"add-tab\"][data-v=\"file\"]"},
        {"eval": "A['add-fq']({value: 'cable_clip'})"},
        {"eval": "A['add-file']({dataset: {id: String(DB.library.find((f) => f.name.startsWith('cable_clip_set')).id)}})"},
        {"eval": "A['add-plate']({value: '2'})"},
        {"eval": "A['add-copies']({value: '3'}); renderAdd()"}
      ]
    },
    "app": {
      "route": "/projects/{order:241}",
      "stand_rows": ["cable_clip_set.gcode.3mf"],
      "actions": [
        {"click_button": "^Додати в замовлення$"},
        {"click_role_tab": "^Разовий з файлу"},
        {"eval": "(() => { const i = document.querySelector('[role=\"dialog\"] [role=\"tabpanel\"]:not([hidden]) input[type=\"search\"]'); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, 'cable_clip'); i.dispatchEvent(new Event('input', {bubbles: true})); })()"},
        {"click": "[role=\"dialog\"] [role=\"tabpanel\"]:not([hidden]) ul button:has-text(\"cable_clip_set\")"},
        {"check": "[role=\"dialog\"] [role=\"radiogroup\"] label:nth-child(2) input[type=\"radio\"]"},
        {"eval": "(() => { const i = document.querySelector('[role=\"dialog\"] input[aria-label=\"Копій плити\"]'); Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value').set.call(i, '3'); i.dispatchEvent(new Event('input', {bubbles: true})); })()"}
      ]
    }
  },
  {
    "id": "e05-config-241",
    "widths": "all",
    "measure": "dialog",
    "pair": "order:241",
    "mockup": {
      "route": "#/orders/241",
      "actions": [{"eval": "A['line-config']({dataset: {id: '241', line: '1'}})"}]
    },
    "app": {
      "route": "/projects/{order:241}",
      "actions": [
        {"click": "tr[data-line] button[aria-label^=\"Дії позиції\"]"},
        {"click": "[role=\"menuitem\"]:has-text(\"Конфігурація деталей\")"}
      ]
    }
  },
  {
    "id": "e05-product-to-order",
    "widths": "wide",
    "measure": "dialog",
    "pair": "product:2",
    "mockup": {
      "route": "#/products/2",
      "actions": [
        {"click": "[data-a=\"product-to-order\"][data-id=\"2\"]"},
        {"eval": "A['add-order']({value: '241'})"}
      ]
    },
    "app": {
      "route": "/products/{product:2}",
      "actions": [
        {"click_button": "^Додати в замовлення$"},
        {"eval": "(() => { const s = document.querySelector('[role=\"dialog\"] select[aria-label=\"Замовлення\"]'); const o = [...s.options].find((x) => x.textContent.includes('Корпуси датчиків клімату')); Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, 'value').set.call(s, o.value); s.dispatchEvent(new Event('change', {bubbles: true})); })()"}
      ]
    }
  }
]
