#23 = APPLICATION_CONTEXT('');
#24 = PRODUCT_CONTEXT('',#23,'');
#25 = PRODUCT('20001','external-part.stp-Doc','',(#24));
#26 = PRODUCT_DEFINITION_FORMATION('1','',#25);
#27 = DOCUMENT_PRODUCT_EQUIVALENCE('equivalence',$,#22,#26);
#28 = PRODUCT_DEFINITION_CONTEXT('digital document definition',#23,'');
#29 = DOCUMENT_TYPE('');
#30 = DOCUMENT_FILE('external-part.stp','',$,#29,'',$);
#31 = PRODUCT_DEFINITION_WITH_ASSOCIATED_DOCUMENTS('1','',#26,#28,(#30));
